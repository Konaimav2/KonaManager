id=appguard
name=AppGuard
desc=Kills idle background apps to keep memory free
kind=daemon
source=builtin
version=2.0.0
start=@ADB@/service.d/appguard.sh
boot_script=@ADB@/service.d/appguard.sh
stop=cmd:@ADB@/appguard/appguard.sh stop
pidfile=@ADB@/appguard/appguard.pid
argv_match=@ADB@/appguard/appguard.sh
stop_scope=marker
start_timeout=15
stop_grace=10
health=heartbeat:@R@/appguard/heartbeat:auto
boot=xbit
removable=0
adopt=argv
log=@ADB@/appguard/appguard.log
